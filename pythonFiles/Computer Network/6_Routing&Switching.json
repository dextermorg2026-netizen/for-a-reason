{
  "slides": [
    {
      "title": "Routing Basics",
      "content": [
        "Routing is the process of selecting the best path for data packets",
        "Packets travel through multiple networks via routers",
        "Routers decide next hop using routing tables",
        "Ensures efficient data delivery across networks",
        "Used extensively in the Internet"
      ]
    },
    {
      "title": "Routing Purpose",
      "content": [
        "Helps packets reach destination efficiently",
        "Uses algorithms to determine optimal path",
        "Reduces delay and congestion",
        "Supports communication across networks",
        "Essential for large-scale network systems"
      ]
    },
    {
      "title": "Static Routing",
      "content": [
        "Routing tables are manually configured",
        "Simple and easy to implement",
        "Does not adapt to network changes",
        "Suitable for small networks",
        "Low overhead but not scalable"
      ]
    },
    {
      "title": "Dynamic Routing",
      "content": [
        "Routing tables are updated automatically",
        "Adapts to network changes and failures",
        "Uses routing protocols",
        "Suitable for large networks",
        "More complex but highly efficient"
      ]
    },
    {
      "title": "Distance Vector Routing",
      "content": [
        "Routers maintain distance and next hop information",
        "Routing tables shared with neighbors periodically",
        "Updates based on neighbor information",
        "Calculates shortest path incrementally",
        "Simple distributed approach"
      ]
    },
    {
      "title": "Bellman-Ford Concept",
      "content": [
        "Used in distance vector routing",
        "Calculates shortest path iteratively",
        "Considers neighbor cost plus path cost",
        "Updates routing table repeatedly",
        "Ensures minimum distance path"
      ]
    },
    {
      "title": "Distance Vector Limitations",
      "content": [
        "Slow convergence after network changes",
        "Prone to routing loops",
        "Count-to-infinity problem occurs",
        "Limited scalability",
        "Less efficient for large networks"
      ]
    },
    {
      "title": "Link State Routing",
      "content": [
        "Each router builds full network topology",
        "Shares link state information with all routers",
        "Uses complete network knowledge",
        "Calculates optimal paths independently",
        "More advanced than distance vector"
      ]
    },
    {
      "title": "Dijkstra Algorithm",
      "content": [
        "Used in link state routing",
        "Finds shortest path tree",
        "Selects nearest node iteratively",
        "Updates distance values step by step",
        "Ensures optimal path computation"
      ]
    },
    {
      "title": "Link State Advantages",
      "content": [
        "Fast convergence speed",
        "Avoids routing loops",
        "Accurate path calculation",
        "Efficient for large networks",
        "Better performance than distance vector"
      ]
    },
    {
      "title": "Link State Limitations",
      "content": [
        "Requires more memory",
        "Needs higher processing power",
        "Complex implementation",
        "Higher resource usage",
        "Not ideal for small devices"
      ]
    },
    {
      "title": "RIP Protocol",
      "content": [
        "Distance vector routing protocol",
        "Uses hop count as metric",
        "Maximum hop count is 15",
        "Periodically sends updates",
        "Suitable for small networks"
      ]
    },
    {
      "title": "RIP Limitations",
      "content": [
        "Limited network size due to hop count",
        "Slow convergence",
        "Less efficient routing",
        "Not suitable for large systems",
        "Outdated for modern networks"
      ]
    },
    {
      "title": "OSPF Protocol",
      "content": [
        "Link state routing protocol",
        "Uses Dijkstra algorithm",
        "Supports hierarchical structure",
        "Faster convergence than RIP",
        "Widely used in enterprises"
      ]
    },
    {
      "title": "OSPF Features",
      "content": [
        "Scalable for large networks",
        "Efficient path calculation",
        "Supports areas for hierarchy",
        "Reduces routing overhead",
        "Reliable and high performance"
      ]
    },
    {
      "title": "BGP Protocol",
      "content": [
        "Used for inter-network routing",
        "Connects autonomous systems",
        "Policy-based routing decisions",
        "Used in Internet backbone",
        "Handles large-scale routing"
      ]
    },
    {
      "title": "BGP Characteristics",
      "content": [
        "Does not rely only on shortest path",
        "Uses policies for routing decisions",
        "Highly scalable",
        "Complex configuration",
        "Critical for global Internet routing"
      ]
    },
    {
      "title": "Routing Comparison",
      "content": [
        "Distance vector is simple but slow",
        "Link state is fast but complex",
        "RIP is limited to small networks",
        "OSPF is suitable for enterprises",
        "BGP is used for Internet-level routing"
      ]
    }
  ]
}