            "title": "Log-Based Recovery",
            "content": [
                "Records all operations",
                "Used for undo and redo",
                "Maintains transaction logs",
                "Ensures durability"
            ]
        },
        {
            "title": "Undo and Redo Operations",
            "content": [
                "UNDO: reverses uncommitted changes",
                "REDO: reapplies committed changes",
                "Maintains consistency",
                "Used after crashes"
            ]
        },
        {
            "title": "Write-Ahead Logging (WAL)",
            "content": [
                "Logs written before data changes",
                "Ensures recovery capability",
                "Prevents data loss",
                "Key recovery principle"
            ]
        },
        {
            "title": "Checkpointing",
            "content": [
                "Saves database state periodically",
                "Reduces recovery time",
                "Avoids scanning full log",
                "Improves performance"
            ]
        },
        {
            "title": "Shadow Paging",
            "content": [
                "Maintains two page tables",
                "No overwrite of original data",
                "Simplifies recovery",
                "Less commonly used"
            ]
        },
        {
            "title": "Deferred vs Immediate Update",
            "content": [
                "Deferred: updates after commit",
                "Immediate: updates before commit",
                "Deferred uses REDO only",
                "Immediate uses UNDO + REDO"
            ]
        },
        {
            "title": "Database Backup",
            "content": [
                "Copy of database",
                "Used for restoration",
                "Protects from data loss",
                "Essential for disaster recovery"
            ]
        },
        {
            "title": "Types of Backups",
            "content": [
