                "Important for relational databases",
                "Used in complex queries"
            ]
        },
        {
            "title": "Types of Joins",
            "content": [
                "INNER JOIN",
                "LEFT JOIN",
                "RIGHT JOIN",
                "FULL OUTER JOIN"
            ]
        },
        {
            "title": "INNER and LEFT JOIN",
            "content": [
                "INNER: only matching rows",
