        {
            "title": "Types of Database Languages",
            "content": [
                "DDL: Define database structure",
                "DML: Manipulate data",
                "DCL: Control access",
                "TCL: Manage transactions"
            ]
        },
        {
            "title": "DDL Commands",
            "content": [
                "CREATE: create objects",
                "ALTER: modify structure",
                "DROP: delete objects",
                "TRUNCATE: remove all data"
            ]
        },
        {
            "title": "DML Commands",
            "content": [
                "INSERT: add records",
                "SELECT: retrieve data",
                "UPDATE: modify records",
                "DELETE: remove records"
            ]
        },
        {
            "title": "DCL and TCL",
            "content": [
                "DCL: GRANT, REVOKE",
                "TCL: COMMIT, ROLLBACK",
                "Controls access and transactions",
                "Ensures data integrity"
            ]
        },
        {
            "title": "SQL Clauses",
            "content": [
                "WHERE: filter rows",
                "ORDER BY: sort data",
                "GROUP BY: group data",
                "HAVING: filter groups"
            ]
        },
        {
            "title": "DISTINCT and WHERE",
            "content": [
                "DISTINCT removes duplicates",
                "WHERE filters data",
                "Used to refine results",
                "Improves query accuracy"
            ]
        },
        {
            "title": "GROUP BY and HAVING",
            "content": [
                "GROUP BY groups rows",
                "Used with aggregate functions",
                "HAVING filters grouped data",
                "Used after GROUP BY"
            ]
        },
        {
            "title": "ORDER BY Clause",
            "content": [
                "Sorts results",
                "ASC for ascending",
                "DESC for descending",
                "Can sort multiple columns"
            ]
        },
        {
            "title": "Aggregate Functions",
            "content": [
                "COUNT, SUM, AVG",
                "MIN, MAX",
                "Used for calculations",
                "Return single value"
            ]
        },
        {
            "title": "GROUP BY with Aggregates",
            "content": [
                "Groups data by column",
                "Applies functions on groups",
                "Example: avg salary per department",
                "Useful for reports"
            ]
        },
        {
            "title": "SQL Joins",
            "content": [
                "Combine data from multiple tables",
